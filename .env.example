# =====================================================================
# WSNEPAL B2B MARKETPLACE & ERP - ENVIRONMENT VARIABLES CONFIGURATION
# Copy this file to .env or .env.local and fill in your actual values.
# IMPORTANT: Never commit actual secret keys or .env files to git!
# =====================================================================

# Supabase Public Project URL (Client-Side)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public API Key (Client-Side - Requires RLS Enabled on All Tables)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Secret Admin Credentials
VITE_ADMIN_EMAIL=admin@wsnepal.com
VITE_ADMIN_PASSWORD=your_secret_admin_password_here
